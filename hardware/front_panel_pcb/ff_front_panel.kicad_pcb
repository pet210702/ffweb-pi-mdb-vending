		(date "2026-10-28")
		(rev "1.0")
		(company "Freiwillige Feuerwehr")
		(comment 1 "60x56mm Front Panel PCB: 0.96 inch I2C OLED (VCC-GND-SCL-SDA) + 3x 6mm Tactile Buttons")
		(comment 2 "J1: 7-pin JST-XH | J2: 7-pin 2.54mm Dupont Header")
	)
	(layers
		(0 "F.Cu" signal)
		(2 "B.Cu" signal)
		(9 "F.Adhes" user "F.Adhesive")
		(11 "B.Adhes" user "B.Adhesive")
		(13 "F.Paste" user)
		(15 "B.Paste" user)
