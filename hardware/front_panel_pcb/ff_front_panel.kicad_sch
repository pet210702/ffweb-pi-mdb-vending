	(text "FF Getränkeautomat — Front Panel PCB (0.96\" I2C OLED + 3x 6mm Tactile Buttons)\nRaspberry Pi 40-Pin Header Wiring (J1 JST-XH 7P or J2 Dupont 7P):\n  Pin 1 (+3V3)      -> RPi Physical Pin 1 (3.3V Power)\n  Pin 2 (I2C_SDA)   -> RPi Physical Pin 3 (GPIO 2 / SDA1)\n  Pin 3 (I2C_SCL)   -> RPi Physical Pin 5 (GPIO 3 / SCL1)\n  Pin 4 (GND)       -> RPi Physical Pin 9 (or Pin 14 / 20 GND)\n  Pin 5 (BTN1_BACK) -> RPi Physical Pin 11 (GPIO 17 - Zurück / Abbruch)\n  Pin 6 (BTN2_OK)   -> RPi Physical Pin 13 (GPIO 27 - Auswahl / OK)\n  Pin 7 (BTN3_NEXT) -> RPi Physical Pin 15 (GPIO 22 - Weiter)\nOLED Header J3 Pin Order: 1=VCC (+3V3), 2=GND, 3=SCL, 4=SDA"
		(exclude_from_sim no)
		(at 45.72 25.40 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left top)
		)
		(uuid "9b8951ed-a5cf-5a7b-a91c-0036a2c187aa")
	)
