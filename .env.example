# Server settings
HOST=0.0.0.0
PORT=8000
DB_PATH=data/vending.db
# Optional token for admin write endpoints (leave empty on trusted station LAN)
ADMIN_API_TOKEN=

# MDB interface: "simulator" (default until hardware arrives) or "qibixx"
MDB_MODE=simulator
MDB_SERIAL_PORT=/dev/ttyACM0
MDB_BAUDRATE=115200

# USB RFID reader: "auto" (uses evdev on Linux if found, plus API simulator), "evdev", or "simulator"
RFID_MODE=auto
# Optional explicit Linux input device path, e.g. /dev/input/by-id/usb-Sycreader_RFID_...-event-kbd
RFID_DEVICE_PATH=

# 0.96" I2C OLED display: "auto" (SSD1306 128x64 if /dev/i2c-1 present), "ssd1306", "sh1106", or "disabled"
OLED_MODE=auto
OLED_I2C_PORT=1
OLED_I2C_ADDRESS=0x3C
OLED_SCREENSAVER_SEC=90
OLED_STARTUP_DIAG_SEC=6

# Physical 3-button navigation: "auto" (gpiod if /dev/gpiochip0 present), "simulator", or "disabled"
BUTTONS_MODE=auto
BUTTONS_CHIP_PATH=/dev/gpiochip0
BUTTON_PIN_BACK=17
BUTTON_PIN_SELECT=27
BUTTON_PIN_NEXT=22
BUTTON_DEBOUNCE_MS=50
BILLING_SELECTION_TIMEOUT_SEC=12

# Vending timeouts & rules
SESSION_TIMEOUT_SEC=30
AWAITING_CHIP_TIMEOUT_SEC=15
DISPENSE_TIMEOUT_SEC=25
ALLOW_UNMAPPED_SLOTS=false

# FFWEB (https://www.ffweb.at) integration: "mock" or "http"
FFWEB_MODE=mock
FFWEB_BASE_URL=https://api.ffweb.at
FFWEB_API_KEY=
FFWEB_TIMEOUT_SEC=4.0
FFWEB_MEMBER_LOOKUP_PATH=/api/v1/vending/members/{chip_uid}
FFWEB_PRODUCTS_PATH=/api/v1/vending/products
FFWEB_VEND_PATH=/api/v1/vending/consumptions
SYNC_RETRY_INTERVAL_SEC=10
